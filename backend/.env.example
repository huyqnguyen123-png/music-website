# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://music:music@localhost:5433/music?schema=public

# Auth — use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# "none" only when frontend and API are on different domains (needs HTTPS)
COOKIE_SAME_SITE=lax

# iTunes store country (affects which songs are available)
ITUNES_COUNTRY=VN
